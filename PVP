-- ===================== ESP COM HIGHLIGHTS =====================

local function updateHighlight(otherPlayer)
    if not espActive then return end
    if otherPlayer == player then return end
    
    local character = otherPlayer.Character
    if not character then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local highlight = character:FindFirstChild("ESP_Highlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Highlight"
        highlight.Parent = character
        highlight.Adornee = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    end
    
    highlight.FillColor = highlightColor
end

local function removeHighlight(otherPlayer)
    local character = otherPlayer.Character
    if character then
        local highlight = character:FindFirstChild("ESP_Highlight")
        if highlight then
            highlight:Destroy()
        end
    end
end

local function updateAllHighlights()
    if not espActive then return end
    
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            updateHighlight(otherPlayer)
        end
    end
end

local function removeAllHighlights()
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            removeHighlight(otherPlayer)
        end
    end
end

local function toggleESP(state)
    espActive = state
    
    for _, conn in ipairs(espConnections) do
        pcall(conn.Disconnect, conn)
    end
    espConnections = {}
    
    if state then
        updateAllHighlights()
        
        local conn1 = Players.PlayerAdded:Connect(function(otherPlayer)
            if otherPlayer ~= player then
                otherPlayer.CharacterAdded:Connect(function(character)
                    wait(0.5)
                    if espActive then
                        updateHighlight(otherPlayer)
                    end
                end)
                if otherPlayer.Character then
                    updateHighlight(otherPlayer)
                end
            end
        end)
        table.insert(espConnections, conn1)
        
        local conn2 = Players.PlayerRemoving:Connect(function(otherPlayer)
            removeHighlight(otherPlayer)
        end)
        table.insert(espConnections, conn2)
        
        local conn3 = runService.Heartbeat:Connect(function()
            if espActive then
                for _, otherPlayer in ipairs(Players:GetPlayers()) do
                    if otherPlayer ~= player then
                        local character = otherPlayer.Character
                        if character then
                            local highlight = character:FindFirstChild("ESP_Highlight")
                            if not highlight then
                                updateHighlight(otherPlayer)
                            end
                        end
                    end
                end
            end
        end)
        table.insert(espConnections, conn3)
        
        debugLabel.Text = "👁️ ESP ativado! | Cor: " .. colors[colorIndex].name
        debugLabel.TextColor3 = highlightColor
    else
        removeAllHighlights()
        debugLabel.Text = "👁️ ESP desativado"
        debugLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end

-- ===================== HITBOX EXPANDER =====================

local function applyHeadMods(character)
    if not character then return end
    if character == player.Character then return end
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    if not originalHeadSizes[character] then
        originalHeadSizes[character] = head.Size
    end
    
    if originalHeadColors[character] == nil then
        originalHeadColors[character] = head.Transparency
    end
    
    if hitboxActive then
        local originalSize = originalHeadSizes[character]
        if originalSize then
            head.Size = Vector3.new(
                originalSize.X * headSize,
                originalSize.Y * headSize,
                originalSize.Z * headSize
            )
        end
        head.Transparency = headTransparency
    end
end

local function restoreHead(character)
    if not character then return end
    if character == player.Character then return end
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    if originalHeadSizes[character] then
        head.Size = originalHeadSizes[character]
        originalHeadSizes[character] = nil
    end
    
    if originalHeadColors[character] ~= nil then
        head.Transparency = originalHeadColors[character]
        originalHeadColors[character] = nil
    end
end

local function applyToAllEnemies()
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            local character = otherPlayer.Character
            if character then
                applyHeadMods(character)
            end
        end
    end
end

local function restoreAllEnemies()
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            local character = otherPlayer.Character
            if character then
                restoreHead(character)
            end
        end
    end
end

local function toggleHitbox(state)
    hitboxActive = state
    
    if hitboxConnection then
        hitboxConnection:Disconnect()
        hitboxConnection = nil
    end
    
    if state then
        applyToAllEnemies()
        hitboxConnection = runService.Heartbeat:Connect(applyToAllEnemies)
        
        Players.PlayerAdded:Connect(function(otherPlayer)
            if otherPlayer ~= player then
                otherPlayer.CharacterAdded:Connect(function(character)
                    if hitboxActive then
                        applyHeadMods(character)
                    end
                end)
            end
        end)
        
        debugLabel.Text = "🎯 Hitbox ativada! Tamanho: " .. string.format("%.1f", headSize) .. "x | Transp: " .. math.floor(headTransparency * 100) .. "%"
        debugLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    else
        restoreAllEnemies()
        debugLabel.Text = "🎯 Hitbox desativada"
        debugLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end

local function updateHeadSize(newSize)
    headSize = math.max(0.5, math.min(5, newSize))
    sizeLabel.Text = "Tamanho: " .. string.format("%.1f", headSize) .. "x"
    if hitboxActive then
        applyToAllEnemies()
        debugLabel.Text = "🎯 Tamanho: " .. string.format("%.1f", headSize) .. "x | Transp: " .. math.floor(headTransparency * 100) .. "%"
        debugLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    end
end

local function updateTransparency(newTrans)
    headTransparency = math.max(0, math.min(1, newTrans))
    transLabel.Text = "Transparência: " .. math.floor(headTransparency * 100) .. "%"
    if hitboxActive then
        applyToAllEnemies()
        debugLabel.Text = "🎯 Tamanho: " .. string.format("%.1f", headSize) .. "x | Transp: " .. math.floor(headTransparency * 100) .. "%"
        debugLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    end
end

local function changeColor()
    colorIndex = colorIndex + 1
    if colorIndex > #colors then colorIndex = 1 end
    
    highlightColor = colors[colorIndex].color
    colorLabel.Text = "Cor ESP: " .. colors[colorIndex].name
    
    if espActive then
        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= player then
                local character = otherPlayer.Character
                if character then
                    local highlight = character:FindFirstChild("ESP_Highlight")
                    if highlight then
                        highlight.FillColor = highlightColor
                    end
                end
            end
        end
        debugLabel.Text = "🎨 Cor alterada para: " .. colors[colorIndex].name
        debugLabel.TextColor3 = highlightColor
    end
end

